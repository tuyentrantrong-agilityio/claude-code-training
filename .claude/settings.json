{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./archive/**)",
      "Write(./archive/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
