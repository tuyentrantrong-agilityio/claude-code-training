APP_ENV=development
DATABASE_URL=postgresql+asyncpg://recapz:recapz@localhost:5432/recapz
CORS_ORIGINS=["http://localhost:5173"]
# AI providers. Every function defaults to "fake": tests and CI never call paid APIs.
# To use real providers (proposal in docs/recapz/09-ai-providers.md), put your keys in the
# local .env only (never commit it) and switch the functions you want:
#   PROVIDER_STT_BATCH=deepgram   needs DEEPGRAM_API_KEY
#   PROVIDER_LLM=anthropic        needs ANTHROPIC_API_KEY
#   PROVIDER_EMBEDDING=openai     needs OPENAI_API_KEY
# A missing key fails fast with a clear error. Check each one with a tiny request:
#   uv run python -m app.providers.smoke --stt sample.wav --llm --embedding
# EMBEDDING_DIMENSIONS must match the search_chunks.embedding column once it is fixed.
PROVIDER_STT_BATCH=fake
PROVIDER_STT_STREAM=fake
PROVIDER_LLM=fake
PROVIDER_EMBEDDING=fake
PROVIDER_TTS=fake
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=2
STT_TIMEOUT_SECONDS=600
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_MODEL=nova-3
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Auth. Google OAuth setup: see docs/recapz/08-google-cloud-setup.md
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
SESSION_TTL_DAYS=14
INVITE_TTL_DAYS=7
# Storage and uploads
STORAGE_DIR=./data/recordings
MAX_UPLOAD_MB=500
ALLOWED_UPLOAD_EXTENSIONS=mp3,m4a,wav,mp4,webm,ogg,mov
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
